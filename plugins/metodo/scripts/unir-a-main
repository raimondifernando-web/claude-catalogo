#!/usr/bin/env -S python3 -I
"""Une la rama de esta sesión a `main` si el PROGRAMA comprueba por su cuenta que es seguro. El sello lo arma él.

Disparador: encadenado — lo corre la sesión al terminar un tema en su rama (paso de unir a main de /cerrar y de
/metodo:cerrar). También a mano: unir-a-main  (sin opciones; --probar hace todo menos subir)

Qué cambió en 0.42.0 (segunda revisión independiente): el main contra el que se juzga se baja a una referencia propia y
se compara con el remoto (la sesión no puede falsificarlo); el .git/config del repo se revisa antes de cualquier
fetch/merge/push; la copia de prueba se arma leyendo los archivos tal cual (sin filtros de git); a la persona se le
pregunta ANTES de correr una sola línea de la rama; el sandbox de Mac no deja ejecutar nada desde la copia, ni crear
tareas en launchd, ni escribir preferencias.

Qué cambió en 0.41.0: antes la sesión afirmaba «lo revisó fulano», «la persona dijo que sí», «no hay pruebas» con
banderas de la línea de comandos. Una sesión engañada podía pasarlas sin que fueran ciertas. Esas banderas YA NO
EXISTEN. Lo que cuenta lo comprueba el programa y lo escribe en un sello atado al commit exacto:

  1. repo permitido: solo los listados en <config de Claude>/unir-a-main.txt (sin lista no une nada);
     el catálogo público nunca (va por PR con checks en GitHub)
  2. rama propia (no main, no m4), sin cambios a medias; trae lo nuevo de main (si hay conflicto, frena)
  3. zona sensible: lo que corre solo en la computadora, o decide cómo se corren las pruebas. Las reglas salen de
     main (nunca de la rama que se juzga) y de las que trae el propio programa
  4. copia limpia del commit (archivos leídos tal cual con cat-file: sin filtros smudge/LFS, sin .gitattributes, sin
     hooks, sin .git) y detección de qué pruebas habría. Todavía NO se ejecuta nada de la rama
  5. revisor independiente: lo LANZA el programa (claude -p, sin herramientas) con el diff leído de git y
     devuelve verde / amarillo / rojo. Solo puede endurecer: rojo no une nunca; amarillo pide a la persona
  6. OK de la persona SOLO si hace falta (zona sensible, cambios que no se pueden leer, dudas del revisor, sin pruebas
     en código, sin aislamiento completo): se muestra en una ventana, en criollo, y queda atado al commit. Se pide
     ANTES de ejecutar las pruebas. No se puede pasar por opción ni por variable
  7. pruebas: recién ahora, en la copia, con entorno vacío (sin claves ni HOME real), sin red, sin poder escribir
     fuera de la copia ni ejecutar nada que esté en ella (Mac: sandbox-exec); fallan = no se une
Después arma el sello (JSON con el hash del diff revisado, pruebas, revisor y OK), lo guarda y lo escribe en el
commit de unión, que sube a main sin forzar. Si main cambió mientras tanto, no sube: volvé a correrlo.

Se corre con `python3 -I` (ignora PYTHONPATH y la carpeta actual) y limpia el entorno: HOME sale de la cuenta del
sistema, no de $HOME; la lista de repos es siempre ~/.claude/unir-a-main.txt (ni $CLAUDE_CONFIG_DIR la mueve).

Límite honesto: una sesión que puede correr cualquier comando como vos puede saltarse este programa (por ejemplo con
`git push` directo, o editando su copia en ~/.claude/scripts). Para eso la defensa es la regla del lado de GitHub (rama protegida, PR + checks + etiqueta
`ok-fernando-<commit>` que solo pone la persona). Ver docs/SELLO-UNIR-A-MAIN.md.
"""
import argparse
import fnmatch
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import pwd


def _casa_real():
    """La carpeta personal sale de la cuenta del sistema, no de $HOME (que la sesión puede cambiar)."""
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, OSError):
        return Path.home()


CASA = _casa_real()
CONFIG = CASA / ".claude"       # fijo: ni $CLAUDE_CONFIG_DIR ni $HOME pueden apuntar a una lista falsa
PERMITIDOS = CONFIG / "unir-a-main.txt"
PATH_FIJO = "/usr/bin:/bin:/usr/sbin:/sbin"


def _bin(nombre, *lugares):
    for d in lugares or ("/usr/bin", "/bin", "/usr/sbin", "/sbin"):
        c = Path(d) / nombre
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    return nombre


GIT = _bin("git", "/usr/bin", "/opt/homebrew/bin", "/usr/local/bin")
# git sin hooks, sin fsmonitor y sin firmar commits. OJO: esto NO apaga lo demás que el .git/config del repo puede
# ejecutar (sshCommand, credential.helper, gpg.program, merge.*.driver, filter.*…): eso lo frena revisar_config_local(),
# que mira la configuración del repo ANTES de cualquier fetch, merge o push.
GIT_SEGURO = ["-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "core.attributesFile=/dev/null",
              "-c", "commit.gpgsign=false", "-c", "tag.gpgsign=false"]
# Claves de la configuración LOCAL del repo que no ejecutan nada. Cualquier otra, una persona la mira antes.
CONFIG_LOCAL_PERMITIDA = re.compile(
    r"^(core\.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks)"
    r"|extensions\.(worktreeconfig|objectformat)"
    r"|user\.(name|email)"
    r"|commit\.gpgsign"                      # se apaga con -c; no puede firmar nada
    r"|remote\.origin\.(url|fetch)"
    r"|branch\..+\.(remote|merge|rebase|vscode-merge-base|description)"
    r"|init\.defaultbranch|pull\.(rebase|ff)|push\.(default|autosetupremote)|fetch\.prune|rerere\.enabled"
    r"|gc\.[a-z.]+|maintenance\.[a-z.]+|advice\.[a-zA-Z]+)$")
REFSPEC_NORMAL = "+refs/heads/*:refs/remotes/origin/*"
REF_BASE = "refs/unir-a-main/base"   # donde el programa guarda el main real que bajó (ver base_de_main)


def entorno_limpio():
    """Entorno mínimo para todo lo que lanza el programa: sin GIT_*, ANTHROPIC_*, CLAUDE_*, PYTHON* ni PATH de la sesión."""
    return {"HOME": str(CASA), "PATH": PATH_FIJO + ":" + os.path.dirname(GIT), "LANG": "en_US.UTF-8",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0"}


def limpiar_entorno():
    os.environ.clear()
    os.environ.update(entorno_limpio())
NUNCA = {"claude-catalogo"}   # público y con clientes: va por PR + checks en GitHub (controles y zona-sensible)
TOPE_COPIA = 400_000_000       # bytes de archivos que se copian para correr las pruebas
TOPE_DIFF = 300_000           # bytes; un cambio más grande no se puede revisar entero: va por PR
OPCIONES_VIEJAS = ("--ok-fernando", "--revisado-por", "--sin-pruebas")

# Lo que corre solo en la computadora, o decide cómo se corren las pruebas. «*» cruza carpetas.
SENSIBLE = [
