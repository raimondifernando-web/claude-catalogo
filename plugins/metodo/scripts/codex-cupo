#!/bin/bash
# Cupo de Codex leído de sus propios registros, sin red ni IA. Correr ANTES de lanzar `codex exec`.
# Regla (regla 16 del método): >=70% → no lanzar trabajo grande; >=90% → no lanzar nada.
f=$(ls -t "$HOME"/.codex/sessions/*/*/*/*.jsonl 2>/dev/null | head -20)
[ -z "$f" ] && { echo "Codex: sin registros"; exit 0; }
# El plan gratis mide una ventana de 30 días (43200 min); Plus mide 5 h (300) y 7 días (10080). Se toma la última
# línea de cupo del registro más reciente y, de sus ventanas, la más llena (así sirve para cualquier plan).
p=""; for x in $f; do
  l=$(grep -o '"rate_limits":{.*"credits"' "$x" 2>/dev/null | tail -1)
  [ -n "$l" ] && { p=$(printf '%s' "$l" | grep -o '"used_percent":[0-9.]*' | grep -o '[0-9.]*$' | sort -n | tail -1); break; }; done
[ -z "$p" ] && { echo "Codex: cupo desconocido (sin dato en los registros recientes)"; exit 0; }
p=${p%.*}
if [ "$p" -ge 90 ]; then echo "Codex: ${p}% del cupo (la ventana más llena) — NO lanzar"; exit 2
elif [ "$p" -ge 70 ]; then echo "Codex: ${p}% del cupo (la ventana más llena) — solo tareas chicas"; exit 1
else echo "Codex: ${p}% del cupo (la ventana más llena) — OK"; fi
