#!/usr/bin/env -S python3 -I
"""Copias de trabajo (git worktree) de un proyecto: dónde viven, en qué estado están y limpieza de las ya unidas.

Disparador: encadenado — lo corre unir-a-main después de unir (limpia las copias YA unidas y sin cambios de
`.worktrees/`), y la regla «copias dentro del proyecto» al abrir una sesión hija (`nueva`). También a mano:
    copias-de-trabajo nueva <tema> [--rama area/tema]     crea <carpeta>/.worktrees/<tema> desde origin/main
    copias-de-trabajo listar [--md]                       todas las copias del repo con su estado (solo lee)
    copias-de-trabajo limpiar [--aplicar]                 saca las de `.worktrees/` unidas y limpias (sin --aplicar: muestra)

Convención: las copias de un proyecto viven DENTRO de la carpeta del proyecto, en `<proyecto>/.worktrees/<tema>`
(ignorada por git), nunca sueltas en ~/Proyectos. Nunca se borra una copia con cambios sin guardar o con commits que
main no tenga; la rama no se borra (solo la carpeta). Termina con «Todo al día ✓» o «Falta: … ✗».
"""
import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

DIR = ".worktrees"


def git(cwd, *args, ok=(0,)):
    r = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True, errors="replace")
    if r.returncode not in ok:
        raise SystemExit(f"Falta: git {' '.join(args)} falló: {(r.stderr or r.stdout).strip()[:300]} ✗")
    return r


def raiz(repo):
    return Path(git(repo, "rev-parse", "--show-toplevel").stdout.strip())


def copias(repo):
    """Lista de dicts con el estado de cada copia del repo (menos la principal)."""
    bloques = git(repo, "worktree", "list", "--porcelain").stdout.strip().split("\n\n")
    out = []
    for i, b in enumerate(bloques):
        campos = dict(l.split(" ", 1) if " " in l else (l, "") for l in b.splitlines())
        ruta = campos.get("worktree", "")
        if i == 0 or not ruta:
            continue
        rama = campos.get("branch", "").replace("refs/heads/", "") or "(suelta)"
        existe = Path(ruta).is_dir()
        sucias = len(git(ruta, "status", "--porcelain", "--untracked-files=no").stdout.splitlines()) if existe else 0
        sin_unir, unida, edad = 0, False, None
        if existe:
            sin_unir = int(git(ruta, "rev-list", "--count", "origin/main..HEAD", ok=(0, 128)).stdout.strip() or 0)
            if sin_unir == 0:
                unida = True
            else:   # ¿unida por squash? lo que cambió ya está igual en main
                archivos = [p for p in git(ruta, "diff", "--name-only", "origin/main...HEAD").stdout.splitlines() if p]
                unida = bool(archivos) and not git(ruta, "diff", "--name-only", "origin/main", "HEAD", "--", *archivos).stdout.strip()
            f = git(ruta, "log", "-1", "--format=%ct").stdout.strip()
            edad = (time.time() - int(f)) / 86400 if f.isdigit() else None
        out.append({"ruta": ruta, "rama": rama, "existe": existe, "sucias": sucias, "sin_unir": sin_unir,
                    "unida": unida, "edad": edad, "dentro": f"/{DIR}/" in ruta + "/"})
    return out


def estado(c):
    if not c["existe"]:
        return "carpeta borrada (git la recuerda)"
    if c["sucias"]:
        return f"CON TRABAJO SIN GUARDAR ({c['sucias']} archivos)"
    if c["unida"]:
        return "unida a main"
    return f"CON TRABAJO SIN UNIR ({c['sin_unir']} commits)"


def listar(a):
    repo = raiz(a.repo)
    git(repo, "fetch", "-q", "origin", "main", ok=(0, 1, 128))
    cs = copias(repo)
    if a.md:
        print("| Carpeta | Rama | Estado | Último cambio | ¿Dentro del proyecto? |\n|---|---|---|---|---|")
        for c in sorted(cs, key=lambda c: (c["unida"], c["ruta"])):
            edad = "—" if c["edad"] is None else f"hace {c['edad']:.0f} d"
            print(f"| `{c['ruta']}` | `{c['rama']}` | {estado(c)} | {edad} | {'sí' if c['dentro'] else 'no (suelta)'} |")
    else:
        for c in cs:
            print(f"{estado(c):38} {c['rama']:40} {c['ruta']}")
    unidas = sum(1 for c in cs if c["unida"] and not c["sucias"])
    print(f"\n{len(cs)} copias: {unidas} unidas y limpias, {len(cs) - unidas} con trabajo sin unir, sin guardar o sin carpeta.")
    return 0


def limpiar(a):
    repo = raiz(a.repo)
    git(repo, "fetch", "-q", "origin", "main", ok=(0, 1, 128))
    actual = Path(os.getcwd()).resolve()
    candidatas = [c for c in copias(repo) if c["dentro"] and c["existe"] and c["unida"] and not c["sucias"]]
    hechas = 0
    for c in candidatas:
        ruta = Path(c["ruta"]).resolve()
        if actual == ruta or ruta in actual.parents:
            print(f"  · {c['ruta']}: es la copia donde estás; se limpia desde otra sesión o después de cerrar")
            continue
        if not a.aplicar:
            print(f"  · se sacaría {c['ruta']} (rama {c['rama']}, {estado(c)})")
            continue
        r = subprocess.run(["git", "-C", str(repo), "worktree", "remove", c["ruta"]], capture_output=True, text=True)
        if r.returncode:
            print(f"  · no se pudo sacar {c['ruta']}: {r.stderr.strip()[:200]}")
        else:
            hechas += 1
            print(f"  · sacada {c['ruta']} (la rama {c['rama']} queda)")
    git(repo, "worktree", "prune", ok=(0, 1))
    print(f"Todo al día ✓ ({hechas} sacadas)" if a.aplicar else f"Todo al día ✓ ({len(candidatas)} se podrían sacar; usá --aplicar)")
    return 0


def nueva(a):
    proyecto = Path(a.repo).resolve()
    repo = raiz(proyecto)
    tema = a.tema.strip().replace(" ", "-")
    if not tema or "/" in tema:
        raise SystemExit("Falta: el tema es una palabra corta, sin barras ✗")
    destino = proyecto / DIR / tema
    if destino.exists():
        raise SystemExit(f"Falta: {destino} ya existe ✗")
    rama = a.rama or f"{proyecto.name.lower()}/{tema}"
    git(repo, "fetch", "-q", "origin", "main")
    # ignorada por git sin tocar el .gitignore del proyecto
    info = Path(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()) / "info"
    info.mkdir(exist_ok=True)
    excl = info / "exclude"
    if f"{DIR}/" not in (excl.read_text() if excl.exists() else ""):
        with open(excl, "a") as f:
            f.write(f"\n{DIR}/\n")
    git(repo, "worktree", "add", "-q", "-b", rama, str(destino), "origin/main")
    print(f"Todo al día ✓ copia nueva en {destino} (rama {rama}, desde origin/main)")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--repo", default=".")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("listar"); p.add_argument("--md", action="store_true"); p.set_defaults(f=listar)
    p = sub.add_parser("limpiar"); p.add_argument("--aplicar", action="store_true"); p.set_defaults(f=limpiar)
    p = sub.add_parser("nueva"); p.add_argument("tema"); p.add_argument("--rama"); p.set_defaults(f=nueva)
    a = ap.parse_args()
    return a.f(a)


if __name__ == "__main__":
    sys.exit(main())
