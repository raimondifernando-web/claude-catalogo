#!/usr/bin/env python3
"""Frena la subida de nombres de clientes y personas a repositorios que ve otra gente.

Uso:
  nombres-prohibidos agregar  "<nombre>"   suma un nombre o frase a tu lista
  nombres-prohibidos instalar [<repo>]     instala el control antes de cada push (pre-push) en ese repo
  nombres-prohibidos revisar  [<repo>]     revisa el contenido actual del repo (HEAD); sale 1 si encuentra algo
  (como pre-push lo llama git solo; no hace falta correrlo a mano)

La lista se guarda en <config de Claude>/metodo/nombres-prohibidos.txt (una palabra o frase por línea, # = comentario).
Compara sin mayúsculas y por palabra entera. Nunca imprime la lista: solo archivo, línea y la palabra que apareció.
"""
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

MARCA = "# nombres-prohibidos (metodo)"
CERO = "0" * 40


def base_config():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")) / "metodo"


def ruta_lista():
    return base_config() / "nombres-prohibidos.txt"


def nombres():
    p = ruta_lista()
    if not p.is_file():
        return []
    out = set()
    for linea in p.read_text(encoding="utf-8").splitlines():
        linea = linea.split("#", 1)[0].strip()
        if linea:
            out.add(linea.lower())
    return sorted(out)


def partes(lista, sep):
    return [sep.join(re.escape(p) for p in re.split(r"[-\s_]+", n)) for n in lista if n]


def patron(lista):
    if not lista:
        return re.compile(r"(?!x)x")
    return re.compile(r"(?<![A-Za-z0-9])(" + "|".join(partes(lista, r"[-\s_.]*")) + r")(?![A-Za-z0-9])", re.I)


def patron_git(lista):
    """Prefiltro ERE para git grep (el git de macOS no trae -P). Sin -w: git trata «_» como letra y
    dejaría pasar «acme_corp»; el límite de palabra lo decide después el regex de Python."""
    if not lista:
        return ""
    return "(" + "|".join(partes(lista, "[-[:space:]_.]*")) + ")"


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)


def git_ok(repo, *args):
    """Si git falla, se frena (nunca se deja pasar en silencio)."""
    r = git(repo, *args)
    if r.returncode != 0:
        print(f"✗ Subida frenada: no pude revisar ({r.stderr.strip()[:200] or 'git falló'}). No se subió nada.", file=sys.stderr)
        sys.exit(1)
    return r.stdout


LISTA_ACTUAL = []


def revisar_arbol(repo, sha, rx):
    """Nombres de archivo y contenido de todos los archivos de texto en ese commit."""
    hallazgos = []
    for ruta in git_ok(repo, "ls-tree", "-r", "--name-only", sha).splitlines():
        m = rx.search(ruta)
        if m:
            hallazgos.append(f"nombre de archivo {ruta} → «{m.group(1)}»")
    if not LISTA_ACTUAL:
        return hallazgos
    p_git = patron_git(LISTA_ACTUAL)
    if not p_git:
        return hallazgos
    r = git(repo, "grep", "-I", "-n", "-i", "-E", "-e", p_git, sha, "--")
    if r.returncode not in (0, 1):
        git_ok(repo, "grep", "-I", "-n", "-i", "-E", "-e", p_git, sha, "--")
    for linea in r.stdout.splitlines():
        # formato: <sha>:<archivo>:<n>:<texto>
        _, archivo, n, texto = (linea.split(":", 3) + ["", "", ""])[:4]
        m = rx.search(texto)
        if m:
            hallazgos.append(f"{archivo}:{n} → «{m.group(1)}»")
    return hallazgos


def revisar_mensajes(repo, rango, rx):
    """Mensajes, autor y email de cada commit del rango."""
    hallazgos = []
    for bloque in git_ok(repo, "log", "--format=%h %an <%ae> %B%x00", *rango).split("\x00"):
        m = rx.search(bloque)
        if m:
            hallazgos.append(f"mensaje o autor del commit {bloque.strip().split(' ', 1)[0]} → «{m.group(1)}»")
    return hallazgos


def revisar_cambios(repo, rango, rx):
    """Líneas agregadas y archivos tocados en CADA commit del rango (merges incluidos): un nombre que
    entra y sale en la misma subida queda igual en el historial."""
    salida = git_ok(repo, "log", "-p", "--no-color", "--no-ext-diff", "--diff-merges=first-parent",
                    "--format=@@commit %h", *rango)
    hallazgos, commit, archivo, encabezado = [], "?", "?", False
    for linea in salida.splitlines():
        if linea.startswith("@@commit "):
            commit, encabezado = linea.split()[1], False
        elif linea.startswith("diff --git "):
            encabezado = True
            m = rx.search(linea)
            if m:
                hallazgos.append(f"nombre de archivo en commit {commit} → «{m.group(1)}»")
        elif encabezado:
            if linea.startswith("+++ "):
                archivo = linea[6:] if linea.startswith("+++ b/") else linea[4:]
            elif linea.startswith("@@"):
                encabezado = False
        elif linea.startswith("+"):
            m = rx.search(linea)
            if m:
                hallazgos.append(f"{archivo} (commit {commit}) → «{m.group(1)}»")
    return hallazgos


def frenar(hallazgos, donde):
    print(f"✗ Subida frenada: aparece el nombre de un cliente o persona en {donde}:", file=sys.stderr)
    for h in hallazgos[:20]:
        print("   " + h, file=sys.stderr)
    if len(hallazgos) > 20:
        print(f"   … y {len(hallazgos) - 20} más", file=sys.stderr)
    print("Sacalo (o reemplazalo por <cliente>/<persona>) y volvé a subir. No se subió nada.", file=sys.stderr)
    sys.exit(1)


def pre_push(repo):
    lista = LISTA_ACTUAL[:] = nombres()
    if not lista:
        return
    rx = patron(lista)
    for linea in sys.stdin.read().splitlines():
        campos = linea.split()
        if len(campos) != 4 or campos[1] == CERO:  # borrado de rama: nada que revisar
            continue
        local, remoto = campos[1], campos[3]
        # Rama o tag nuevos, o remoto desconocido acá (otro clon, force-push): todo lo que el remoto no tenga.
        if remoto == CERO or git(repo, "cat-file", "-e", f"{remoto}^{{commit}}").returncode != 0:
            rango = [local, "--not", "--remotes"]
        else:
            rango = [f"{remoto}..{local}"]
        h = revisar_arbol(repo, local, rx) + revisar_mensajes(repo, rango, rx) + revisar_cambios(repo, rango, rx)
        if git_ok(repo, "cat-file", "-t", local).strip() == "tag":  # etiqueta con mensaje propio
            m = rx.search(git_ok(repo, "cat-file", "-p", local))
            if m:
                h.append(f"mensaje de la etiqueta {campos[0]} → «{m.group(1)}»")
        if h:
            frenar(h, campos[2])


def instalar(repo):
    repo = Path(repo).expanduser().resolve()
    r = git(repo, "rev-parse", "--git-path", "hooks")
    if r.returncode:
        sys.exit(f"Falta: {repo} no es un repo de git ✗")
    if git(repo, "config", "core.hooksPath").stdout.strip():
        sys.exit("Falta: el repo usa core.hooksPath; instalarlo a mano ahí ✗")
    hook = (repo / r.stdout.strip()) if not Path(r.stdout.strip()).is_absolute() else Path(r.stdout.strip())
    hook = hook / "pre-push"
    if hook.exists():
        texto_previo = hook.read_text(errors="ignore")
        if "# nombres-prohibidos" not in texto_previo:
            sys.exit(f"Falta: {hook} ya tiene otro control; no lo piso ✗")
    hook.parent.mkdir(parents=True, exist_ok=True)
    script_actual = str(Path(__file__).resolve())
    contenido = f"""#!/bin/sh
{MARCA}
SCRIPT={shlex.quote(script_actual)}
if [ ! -f "$SCRIPT" ]; then
  SCRIPT=$(find "${{CLAUDE_CONFIG_DIR:-$HOME/.claude}}/plugins/cache/claude-catalogo/metodo" -name nombres-prohibidos 2>/dev/null | sort -V | tail -1)
fi
if [ -n "$SCRIPT" ] && [ -f "$SCRIPT" ]; then
  exec python3 "$SCRIPT" pre-push "$(git rev-parse --show-toplevel)"
fi
echo "Aviso: no encontré nombres-prohibidos; dejo pasar el push." >&2
exit 0
"""
    hook.write_text(contenido)
    hook.chmod(0o755)
    print(f"Todo al día ✓  (control instalado en {repo.name})")
    if not nombres():
        print("Lista vacía: sumá nombres con nombres-prohibidos agregar")


def agregar(nombre):
    nombre = nombre.strip()
    if not nombre:
        sys.exit("Falta: el nombre a agregar no puede estar vacío ✗")
    p = ruta_lista()
    base = p.parent
    base.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(base, 0o700)
    except OSError:
        pass

    lineas = []
    existentes = set()
    if p.is_file():
        lineas = p.read_text(encoding="utf-8").splitlines()
        for l in lineas:
            c = l.split("#", 1)[0].strip()
            if c:
                existentes.add(c.lower())

    if nombre.lower() in existentes:
        try:
            os.chmod(p, 0o600)
        except OSError:
            pass
        print(f"Listo ✓ «{nombre}» ya estaba en la lista")
        return

    lineas.append(nombre)
    texto = "\n".join(lineas) + "\n"
    fd, tmp = tempfile.mkstemp(dir=str(base), prefix=".nombres-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(texto)
    os.chmod(tmp, 0o600)
    os.replace(tmp, str(p))
    print(f"Listo ✓ «{nombre}» sumado a la lista de nombres prohibidos")


def revisar(repo):
    lista = LISTA_ACTUAL[:] = nombres()
    if not lista:
        print("Todo al día ✓  (0 nombres revisados, 0 encontrados)")
        return
    h = revisar_arbol(repo, "HEAD", patron(lista))
    if h:
        frenar(h, f"{repo.name} (HEAD)")
    print(f"Todo al día ✓  ({len(lista)} nombres revisados, 0 encontrados)")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(2)
    cmd = sys.argv[1]
    if cmd == "agregar":
        if len(sys.argv) < 3 or not sys.argv[2].strip():
            sys.exit("Uso: nombres-prohibidos agregar \"<nombre>\" ✗")
        agregar(sys.argv[2])
    elif cmd == "instalar":
        repo = Path(sys.argv[2]).expanduser() if len(sys.argv) > 2 else Path.cwd()
        instalar(repo)
    elif cmd == "pre-push":
        repo = Path(sys.argv[2]).expanduser() if len(sys.argv) > 2 else Path.cwd()
        pre_push(repo)
    elif cmd == "revisar":
        repo = Path(sys.argv[2]).expanduser() if len(sys.argv) > 2 else Path.cwd()
        revisar(repo)
    else:
        sys.exit(f"Falta: comando desconocido «{cmd}» ✗")


if __name__ == "__main__":
    main()
