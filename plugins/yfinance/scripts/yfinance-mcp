#!/bin/bash
# Arranca el servidor MCP yfmcp (datos de Yahoo Finanzas, solo lectura, sin claves) con uv.
# Disparador: automático — lo lanza Claude Code al abrir cada sesión (servidor «yfinance» del plugin, .mcp.json).
# Prueba de disparo: `claude mcp list` → plugin:yfinance:yfinance ✔ Connected. Pruebas: scripts/tests/probar.sh (uv falso).
# Versión fijada (Mand. XVI del catálogo): yfmcp==0.14.1 (PyPI, MIT) con --exclude-newer: SUS dependencias (yfinance, mcp,
# matplotlib…) quedan congeladas a esa fecha, no entra una versión nueva sin mirar. Para subirla: auditar la nueva y cambiar
# las dos constantes de abajo. Sin «latest», sin rangos.
YFMCP_VERSION="0.14.1"
CONGELAR_A="2026-11-25T00:00:00Z"
UV="${YFINANCE_UV:-$HOME/.local/bin/uv}"            # el actualizador del catálogo (al-dia.sh) lo deja ahí; YFINANCE_UV solo lo usan las pruebas
[ -x "$UV" ] || UV="$(PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin" command -v uv)"   # Claude abre esto sin el PATH de la Terminal
if [ -z "$UV" ] || [ ! -x "$UV" ]; then
  echo "Yahoo Finanzas: falta «uv» (lo instala solo el actualizador del catálogo); el servidor conecta en la primera sesión nueva después de eso." >&2
  exit 1
fi
cd / || exit 1                                       # que ninguna carpeta de proyecto (pyproject, uv.toml) se meta en el medio
exec "$UV" tool run --quiet --python 3.12 --exclude-newer "$CONGELAR_A" "yfmcp==$YFMCP_VERSION"
